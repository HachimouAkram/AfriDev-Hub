# ==============================================================================
# AfriDev Hub - Modèle de Variables d'Environnement (.env.example)
#
# Instructions :
# 1. Copiez ce fichier vers un fichier nommé .env :
#    cp .env.example .env
# 2. Renseignez vos vraies clés (Brevo SMTP, Google OAuth, DB, etc.) dans .env.
# 3. Le fichier .env est exclu du contrôle de version (dans .gitignore) pour
#    garantir que vos clés privées ne soient jamais exposées sur GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONFIGURATION EMAIL (SMTP - BREVO / SENDINBLUE / GMAIL)
# ------------------------------------------------------------------------------
# Obtenez vos identifiants SMTP sur Brevo (https://app.brevo.com/settings/keys/smtp)
SPRING_MAIL_HOST=smtp-relay.brevo.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=votre-compte-smtp@smtp-brevo.com
SPRING_MAIL_PASSWORD=votre-cle-smtp-secrete-xsmtpsib-xxxxxxxxxxxxxxxxxxxx

# Expéditeur utilisé pour l'envoi des codes OTP et notifications
MAIL_FROM_ADDRESS=contact@afridev.africa
MAIL_FROM_NAME=AfriDev Hub

# ------------------------------------------------------------------------------
# 2. AUTHENTIFICATION GOOGLE OAUTH 2.0 (SIGN-IN WITH GOOGLE)
# ------------------------------------------------------------------------------
# Obtenu depuis Google Cloud Console (https://console.cloud.google.com/apis/credentials)
# Type : ID client OAuth 2.0 -> Application Web
GOOGLE_CLIENT_ID=496829118154-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 3. SÉCURITÉ & JETONS JWT
# ------------------------------------------------------------------------------
# Clé secrète de signature des tokens JWT (au minimum 256 bits)
JWT_SECRET=9a6e8b12f4c781d09e3a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e
JWT_EXPIRATION_MS=604800000

# ------------------------------------------------------------------------------
# 4. BASE DE DONNÉES POSTGRESQL
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=15432
DB_NAME=afridev_db
DB_USER=afridev
DB_PASSWORD=afridev_secret

# ------------------------------------------------------------------------------
# 5. CACHE ET SESSIONS REDIS
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=redis_secret

# ------------------------------------------------------------------------------
# 6. CONFIGURATION SERVEURS
# ------------------------------------------------------------------------------
SPRING_SERVER_PORT=8081
FASTAPI_PORT=8000
